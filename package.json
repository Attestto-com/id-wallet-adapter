{
  "name": "@attestto/id-wallet-adapter",
  "version": "0.7.0",
  "description": "Universal wallet adapter for credential wallet extensions — discovery, VP exchange, and cryptographic verification",
  "homepage": "https://attestto.org",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "gate-self-test": "node scripts/gate-self-test.mjs",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build"
  },
  "gateSelfTest": {
    "workflow": ".github/workflows/ci.yml",
    "testScript": "test:run",
    "buildScript": "build",
    "gates": [
      {
        "name": "type-check",
        "script": "lint",
        "seed": "src/__gate__.ts",
        "content": "export const wrong: number = 'not a number'\n"
      },
      {
        "name": "tests",
        "script": "test:run",
        "seed": "src/__gate__.spec.ts",
        "content": "import { describe, expect, it } from 'vitest'\n\ndescribe('gate self-test seed', () => {\n  it('is a deliberate failure', () => {\n    expect(1).toBe(2)\n  })\n})\n"
      },
      {
        "name": "coverage-thresholds",
        "script": "coverage",
        "seed": "src/policy/__gate__.ts",
        "content": "export function neverCalledByAnySpec(value: string): string {\n  return value.toUpperCase()\n}\n"
      }
    ]
  },
  "keywords": [
    "did",
    "credential",
    "wallet",
    "discovery",
    "chapi",
    "verifiable-credentials",
    "verifiable-presentation",
    "w3c",
    "ssi",
    "identity",
    "didcomm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Attestto-com/id-wallet-adapter.git"
  },
  "author": "Eduardo Chongkan <eduardo@attestto.com>",
  "contributors": [
    "Guillermo Chavarria <guillermocc@attestto.com>"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "esbuild": ">=0.28.1 <0.29",
    "form-data": ">=4.0.6 <5",
    "nanoid": ">=3.3.17 <4",
    "postcss": ">=8.5.23 <9",
    "vite": ">=8.0.16 <9",
    "ws": ">=8.21.0 <9"
  }
}
